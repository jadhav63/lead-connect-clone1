# Prepared only. Set private values on the NEW production service after approval.
NODE_ENV=production
APP_ENV=production
WEB_DIST_PATH=../web/dist
AUTH_COOKIE_SAME_SITE=strict
EXPECTED_DATABASE_HOST=REPLACE_WITH_INDEPENDENTLY_VERIFIED_NEW_POOLED_HOST
EXPECTED_DATABASE_NAME=leadconnect_production
EXPECTED_DATABASE_USER=leadconnect_app
# Property identity is provisioned once using bootstrap.env.example; no property or staff rows are seeded here.
DATABASE_URL=SET_PRIVATELY_IN_APPROVED_SECRET_STORE
JWT_ACCESS_SECRET=GENERATE_PRIVATELY_WITH_48_RANDOM_BYTES_OR_MORE
CORS_ORIGIN=SET_TO_THE_EXACT_APPROVED_HTTPS_APPLICATION_ORIGIN
REFRESH_TOKEN_DAYS=7
# Imports remain disabled until JD approves the current PMS/floor-plan map.
TGH_IMPORT_ENABLED=false
# Only set after approval: TGH_APPROVED_ROOM_INVENTORY_SHA256=<64 lowercase hex characters>
# No DIRECT_URL/migrator password, BOOTSTRAP password or DEMO_* credentials on runtime.
