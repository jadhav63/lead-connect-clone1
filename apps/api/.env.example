NODE_ENV=development
PORT=4000
POSTGRES_PASSWORD=REPLACE_ME
DATABASE_URL=postgresql://leadconnect:REPLACE_ME@localhost:5432/leadconnect?schema=public
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_48_BYTE_HEX
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
CORS_ORIGIN=http://localhost:5173
BOOTSTRAP_PROPERTY_NAME=Demo Hotel
BOOTSTRAP_PROPERTY_CODE=DEMO
BOOTSTRAP_ADMIN_NAME=Initial Manager
BOOTSTRAP_ADMIN_EMAIL=manager@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# DIRECT_URL may be set privately for Prisma CLI migrations; never commit its value.

# Optional same-origin frontend build directory (relative to apps/api).
# WEB_DIST_PATH=../web/dist
APP_ENV=local
AUTH_COOKIE_SAME_SITE=strict
# Production uses deploy/production/runtime.env.example and explicit target approval.
# BOOTSTRAP_CONFIRM_PROPERTY_CODE and BOOTSTRAP_APPROVAL_REFERENCE are required for production bootstrap.
